# Copy to deploy/publish.env (git-ignored) and fill in for your host.

# Path the web server serves static files from. publish.sh replaces it with a
# symlink to apps/web/dist, so the server must be willing to follow symlinks and
# to read the directory from disk per request.
PUBLISH_LINK=/srv/www/public/spike

# The URL that path is reachable at, including the file — some servers hand a
# bare directory to an SPA fallback before the static handler sees it.
PUBLISH_URL=https://example.com/spike/index.html

# Vite base path the bundle is built with. Must match the URL prefix above.
PUBLISH_BASE_PATH=/spike/
